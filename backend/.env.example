# ---------------------------------------------------------------------------
# MISE EN PRODUCTION — à régler avant d'exposer l'application
#
#   APP_ENV=production
#   APP_DEBUG=false              sinon les traces d'erreur exposent les chemins
#                                du serveur et la pile d'appels
#   APP_URL=https://…            l'adresse réelle, en HTTPS
#   SESSION_SECURE_COOKIE=true   sans quoi le cookie de session voyage aussi
#                                en clair sur HTTP
#   SESSION_ENCRYPT=true         chiffre le contenu de la session en base
#   SANCTUM_STATEFUL_DOMAINS=    le domaine de production, et lui seul
#
#   APP_KEY=base64:…             OBLIGATOIRE. Sans elle, l'interface répond 500
#                                sur toutes ses pages : elle ouvre une session,
#                                et une session se chiffre. L'API, elle, répond
#                                encore — d'où un diagnostic trompeur. Ce
#                                fichier étant hors du dépôt, aucune clé n'est
#                                transmise à l'hébergeur : générez-en une avec
#                                « php artisan key:generate --show » et
#                                collez-la dans ses variables d'environnement.
#
#   SESSION_DRIVER=database      PAS « file ». Sur un hébergeur, le disque est
#   CACHE_STORE=database         éphémère et propre à chaque instance : les
#                                sessions posées sur disque disparaissent au
#                                redéploiement et ne suivent pas d'une instance
#                                à l'autre, ce qui déconnecte les utilisateurs
#                                sans motif apparent.
#
# Et à la première connexion : changer le mot de passe du compte ADMIN.
# ---------------------------------------------------------------------------

APP_NAME="Carburant COVEC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
